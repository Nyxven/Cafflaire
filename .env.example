# Neon (auto-injected by Vercel when you add Neon from Storage; use `vercel env pull .env.local` locally)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth  (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional - Google button needs these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_NAME=Brew Your Own
NEXT_PUBLIC_CURRENCY=PHP
NEXT_PUBLIC_DELIVERY_FEE_CENTS=5000
# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=
