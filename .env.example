# Neon (auto-injected by Vercel when you add Neon from Storage; use `vercel env pull .env.local` locally)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth  (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encrypts emails, names, phones, addresses, session tokens in the database (generate: openssl rand -base64 32).
# Keep a backup: losing it makes encrypted data unreadable.
DATA_ENCRYPTION_KEY=

# SMTP for sending one-time codes (e.g. Brevo smtp-relay.brevo.com:587, or Gmail smtp.gmail.com:465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cafflaire <you@example.com>

# App
NEXT_PUBLIC_APP_NAME=Cafflaire
NEXT_PUBLIC_CURRENCY=PHP
NEXT_PUBLIC_DELIVERY_FEE_CENTS=5000
# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=

# Store details (still undecided - optional, shown at checkout/orders when set)
NEXT_PUBLIC_MIN_PREP_MINUTES=15
NEXT_PUBLIC_PICKUP_ADDRESS=
NEXT_PUBLIC_DELIVERY_AREA=
NEXT_PUBLIC_STORE_HOURS=

# ElevenLabs voice (LOCAL ONLY, used by `node scripts/generate-voice.mjs`; do NOT add these to Vercel)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
